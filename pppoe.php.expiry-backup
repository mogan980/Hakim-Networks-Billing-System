<?php
require_once "config/database.php";
require_once "/var/www/html/vendor/autoload.php";

use RouterOS\Client;
use RouterOS\Config;
use RouterOS\Query;

$message = "";
$error = "";

$settings = $pdo->query("SELECT * FROM mikrotik_settings ORDER BY id DESC LIMIT 1")->fetch(PDO::FETCH_ASSOC);

function getApi($settings) {
    return new Client(new Config([
        "host" => $settings["router_ip"],
        "user" => $settings["router_username"],
        "pass" => $settings["router_password"],
        "port" => (int)$settings["api_port"],
    ]));
}

// PPPoE Actions: enable, disable, delete
if ($_SERVER["REQUEST_METHOD"] === "POST" && isset($_POST["pppoe_action"])) {
    try {
        if (!$settings) throw new Exception("MikroTik settings missing.");

        $api = getApi($settings);

        $username = trim($_POST["username"] ?? "");
        $action = trim($_POST["pppoe_action"] ?? "");

        if (!$username || !$action) {
            throw new Exception("Invalid PPPoE action.");
        }

        $found = $api->query(
            (new Query("/ppp/secret/print"))
                ->where("name", $username)
        )->read();

        if (empty($found)) {
            throw new Exception("PPPoE client not found.");
        }

        $id = $found[0][".id"];

        if ($action === "disable") {
            $api->query(
                (new Query("/ppp/secret/set"))
                    ->equal(".id", $id)
                    ->equal("disabled", "yes")
            )->read();

            $active = $api->query(
                (new Query("/ppp/active/print"))
                    ->where("name", $username)
            )->read();

            foreach ($active as $a) {
                if (!empty($a[".id"])) {
                    $api->query(
                        (new Query("/ppp/active/remove"))
                            ->equal(".id", $a[".id"])
                    )->read();
                }
            }

            $message = "PPPoE client disabled and disconnected.";
        }

        if ($action === "enable") {
            $api->query(
                (new Query("/ppp/secret/set"))
                    ->equal(".id", $id)
                    ->equal("disabled", "no")
            )->read();

            $message = "PPPoE client enabled.";
        }

        if ($action === "delete") {
            $active = $api->query(
                (new Query("/ppp/active/print"))
                    ->where("name", $username)
            )->read();

            foreach ($active as $a) {
                if (!empty($a[".id"])) {
                    $api->query(
                        (new Query("/ppp/active/remove"))
                            ->equal(".id", $a[".id"])
                    )->read();
                }
            }

            $api->query(
                (new Query("/ppp/secret/remove"))
                    ->equal(".id", $id)
            )->read();

            $message = "PPPoE client deleted.";
        }

    } catch (Exception $e) {
        $error = $e->getMessage();
    }
}


if ($_SERVER["REQUEST_METHOD"] === "POST" && isset($_POST["add_pppoe"])) {
    try {
        if (!$settings) throw new Exception("MikroTik settings missing.");

        $api = getApi($settings);

        $name = trim($_POST["username"]);
        $password = trim($_POST["password"]);
        $profile = trim($_POST["profile"]);
        $comment = trim($_POST["comment"]);

        if (!$name || !$password || !$profile) {
            throw new Exception("Username, password and profile are required.");
        }

        $api->query(
            (new Query("/ppp/secret/add"))
                ->equal("name", $name)
                ->equal("password", $password)
                ->equal("service", "pppoe")
                ->equal("profile", $profile)
                ->equal("comment", $comment)
        )->read();

        $message = "PPPoE client added successfully.";

    } catch (Exception $e) {
        $error = $e->getMessage();
    }
}

$secrets = [];
$active = [];

try {
    if ($settings) {
        $api = getApi($settings);

        $secrets = $api->query(new Query("/ppp/secret/print"))->read();
        $active = $api->query(new Query("/ppp/active/print"))->read();
    }
} catch (Exception $e) {
    $error = $e->getMessage();
}
