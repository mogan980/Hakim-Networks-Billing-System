date_default_timezone_set("Africa/Nairobi");
require_once __DIR__ . "/vendor/autoload.php";
require_once __DIR__ . "/config/database.php";

use RouterOS\Client;
use RouterOS\Query;

$pdo->exec("SET time_zone = '+03:00'");

function h($v){ return htmlspecialchars((string)$v, ENT_QUOTES, "UTF-8"); }
function has_col($pdo,$table,$col){
    try{
        $s=$pdo->prepare("SHOW COLUMNS FROM `$table` LIKE ?");
        $s->execute([$col]);
        return (bool)$s->fetch();
    }catch(Exception $e){ return false; }
}
function ensure_tables($pdo){
    try{
        if(!has_col($pdo,"payments","expires_at")){
            $pdo->exec("ALTER TABLE payments ADD COLUMN expires_at DATETIME NULL AFTER created_at");
        }
    }catch(Exception $e){}

    $pdo->exec("
        CREATE TABLE IF NOT EXISTS pppoe_client_expiry (
            id INT AUTO_INCREMENT PRIMARY KEY,
            username VARCHAR(100) UNIQUE,
            expires_at DATETIME NULL,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
        )
    ");
}
ensure_tables($pdo);

function mt(){
    $cfg=require __DIR__ . "/config/mikrotik.php";
    foreach(array_unique([$cfg["host"] ?? "192.168.88.1","192.168.88.1","10.10.10.1"]) as $host){
        try{
            return new Client([
                "host"=>$host,
                "user"=>$cfg["user"],
                "pass"=>$cfg["pass"],
                "port"=>$cfg["port"],
                "timeout"=>5
            ]);
        }catch(Exception $e){}
    }
    return null;
}

function disconnect_ip($client,$ip){
    if(!$client || !$ip) return false;
    $done=false;

    try{
        foreach($client->query((new Query("/ip/hotspot/active/print"))->where("address",$ip))->read() as $a){
            if(isset($a[".id"])){
                $client->query((new Query("/ip/hotspot/active/remove"))->equal(".id",$a[".id"]))->read();
                $done=true;
            }
        }
    }catch(Exception $e){}

    try{
        foreach($client->query(new Query("/queue/simple/print"))->read() as $q){
            if(isset($q["target"],$q[".id"]) && str_contains($q["target"],$ip)){
                $client->query((new Query("/queue/simple/remove"))->equal(".id",$q[".id"]))->read();
                $done=true;
            }
        }
    }catch(Exception $e){}

    return $done;
}

function disconnect_pppoe($client,$username){
    if(!$client || !$username) return false;
    $done=false;

    try{
        foreach($client->query((new Query("/ppp/active/print"))->where("name",$username))->read() as $a){
            if(isset($a[".id"])){
                $client->query((new Query("/ppp/active/remove"))->equal(".id",$a[".id"]))->read();
                $done=true;
            }
        }
    }catch(Exception $e){}

    return $done;
}

$client=mt();
$msg="";

if($_SERVER["REQUEST_METHOD"]==="POST"){
    $source=$_POST["source"] ?? "";
    $id=$_POST["id"] ?? "";
    $action=$_POST["action"] ?? "";
    $hours=max(1,(int)($_POST["hours"] ?? 1));

    if($source==="voucher"){
        $s=$pdo->prepare("SELECT * FROM smart_vouchers WHERE id=?");
        $s->execute([$id]);
        $r=$s->fetch(PDO::FETCH_ASSOC);
        if($r){
            $ip=trim($r["used_by"] ?? "");
            if($action==="disconnect"){ disconnect_ip($client,$ip); $msg="Voucher client disconnected."; }
            if($action==="clean"){ disconnect_ip($client,$ip); $pdo->prepare("UPDATE smart_vouchers SET status='expired' WHERE id=?")->execute([$id]); $msg="Voucher cleaned."; }
            if($action==="extend"){
                $pdo->prepare("UPDATE smart_vouchers SET expires_at=DATE_ADD(GREATEST(COALESCE(expires_at,NOW()),NOW()), INTERVAL ? HOUR), status='used' WHERE id=?")->execute([$hours,$id]);
                $msg="Voucher extended by {$hours} hour(s).";
            }
            if($action==="delete"){ disconnect_ip($client,$ip); $pdo->prepare("DELETE FROM smart_vouchers WHERE id=?")->execute([$id]); $msg="Voucher deleted."; }
        }
    }

    if($source==="stk"){
        $s=$pdo->prepare("SELECT * FROM payments WHERE id=?");
        $s->execute([$id]);
        $r=$s->fetch(PDO::FETCH_ASSOC);
        if($r){
            $ip=trim($r["client_ip"] ?? "");
            if($action==="disconnect"){ disconnect_ip($client,$ip); $msg="STK client disconnected."; }
            if($action==="clean"){ disconnect_ip($client,$ip); $pdo->prepare("UPDATE payments SET status='expired' WHERE id=?")->execute([$id]); $msg="STK client cleaned."; }
            if($action==="extend"){
                $pdo->prepare("UPDATE payments SET expires_at=DATE_ADD(GREATEST(COALESCE(expires_at,NOW()),NOW()), INTERVAL ? HOUR), status='paid' WHERE id=?")->execute([$hours,$id]);
                $msg="STK client extended by {$hours} hour(s).";
            }
            if($action==="delete"){ disconnect_ip($client,$ip); $pdo->prepare("DELETE FROM payments WHERE id=?")->execute([$id]); $msg="STK record deleted."; }
        }
    }

    if($source==="pppoe"){
        $username=$id;
        if($action==="disconnect"){ disconnect_pppoe($client,$username); $msg="PPPoE client disconnected."; }
        if($action==="clean"){ disconnect_pppoe($client,$username); $msg="PPPoE expired client cleaned."; }
        if($action==="extend"){
            $pdo->prepare("
                INSERT INTO pppoe_client_expiry(username,expires_at)
                VALUES(?,DATE_ADD(NOW(), INTERVAL ? HOUR))
                ON DUPLICATE KEY UPDATE expires_at=DATE_ADD(GREATEST(COALESCE(expires_at,NOW()),NOW()), INTERVAL ? HOUR)
            ")->execute([$username,$hours,$hours]);
            $msg="PPPoE client extended by {$hours} hour(s).";
        }
        if($action==="delete"){
            disconnect_pppoe($client,$username);
            if($client){
                try{
                    foreach($client->query((new Query("/ppp/secret/print"))->where("name",$username))->read() as $sec){
                        if(isset($sec[".id"])){
                            $client->query((new Query("/ppp/secret/remove"))->equal(".id",$sec[".id"]))->read();
                        }
                    }
                }catch(Exception $e){}
            }
            $pdo->prepare("DELETE FROM pppoe_client_expiry WHERE username=?")->execute([$username]);
            $msg="PPPoE client deleted.";
        }
    }
}

if(isset($_GET["auto_clean"])){
    $cleaned=0;

    foreach($pdo->query("SELECT * FROM smart_vouchers WHERE status='used' AND expires_at IS NOT NULL AND expires_at<=NOW()")->fetchAll(PDO::FETCH_ASSOC) as $r){
        if(disconnect_ip($client,trim($r["used_by"] ?? ""))) $cleaned++;
        $pdo->prepare("UPDATE smart_vouchers SET status='expired' WHERE id=?")->execute([$r["id"]]);
    }

    foreach($pdo->query("SELECT * FROM payments WHERE status='paid' AND expires_at IS NOT NULL AND expires_at<=NOW()")->fetchAll(PDO::FETCH_ASSOC) as $r){
        if(disconnect_ip($client,trim($r["client_ip"] ?? ""))) $cleaned++;
        $pdo->prepare("UPDATE payments SET status='expired' WHERE id=?")->execute([$r["id"]]);
    }

    foreach($pdo->query("SELECT * FROM pppoe_client_expiry WHERE expires_at IS NOT NULL AND expires_at<=NOW()")->fetchAll(PDO::FETCH_ASSOC) as $r){
        if(disconnect_pppoe($client,$r["username"])) $cleaned++;
    }

    $msg="Auto clean complete. Removed {$cleaned} expired online client(s).";
}

$onlineIps=[];
$pppOnline=[];
$pppSecrets=[];

if($client){
    try{
        foreach($client->query(new Query("/ip/hotspot/active/print"))->read() as $a){
            if(!empty($a["address"])) $onlineIps[$a["address"]]=true;
        }
    }catch(Exception $e){}

    try{
        foreach($client->query(new Query("/ppp/active/print"))->read() as $a){
            if(!empty($a["name"])) $pppOnline[$a["name"]]=true;
        }
    }catch(Exception $e){}

    try{
        $pppSecrets=$client->query(new Query("/ppp/secret/print"))->read();
    }catch(Exception $e){}
}

$sourceFilter=$_GET["source"] ?? "all";
$limit=$_GET["limit"] ?? "20";
$search=trim($_GET["search"] ?? "");

$hotspotActiveRows = [];
if($client){
    try{
        foreach($client->query(new Query("/ip/hotspot/active/print"))->read() as $a){
            $addr = $a["address"] ?? "";
            $user = $a["user"] ?? ($a["name"] ?? "");
            if($addr){
                $hotspotActiveRows[] = [
                    "source"=>"hotspot-active",
                    "id"=>$a[".id"] ?? $addr,
