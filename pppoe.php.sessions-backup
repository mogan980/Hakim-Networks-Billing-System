<script>
document.addEventListener("DOMContentLoaded", function(){
    const search = document.getElementById("pppoeSearch");
    const rows = document.querySelectorAll("#pppoeTable tbody tr");
    const count = document.getElementById("pppoeCount");

    function updateCount(){
        let visible = 0;
        rows.forEach(row=>{
            if(row.style.display !== "none") visible++;
        });
        if(count) count.innerText = "Showing " + visible + " PPPoE clients";
    }

    if(search){
        search.addEventListener("keyup", function(){
            const value = this.value.toLowerCase();
            rows.forEach(row=>{
                row.style.display = row.innerText.toLowerCase().includes(value) ? "" : "none";
            });
            updateCount();
        });
    }

    updateCount();
});
