<script id="HN_STK_MONITOR_LIVE_CLEAN">
document.addEventListener("DOMContentLoaded",()=>{

  function money(n){
    return "KES " + Number(n || 0).toLocaleString();
  }

  function badge(status){
    status=(status||"").toLowerCase();
    if(status==="paid") return '<span class="stk-status-paid">PAID</span>';
    if(status==="pending") return '<span class="stk-status-pending">PENDING</span>';
    return '<span class="stk-status-failed">'+status.toUpperCase()+'</span>';
  }

  function updateCard(label,value){
    document.querySelectorAll(".card,.stat-card,div").forEach(card=>{
      const t=card.innerText||"";
      if(t.includes(label)){
        const num=card.querySelector("h2,h3,b,strong");
        if(num) num.textContent=value;
      }
    });
  }

  async function syncSTK(){
    try{
      const r=await fetch("stk_monitor_live_api.php?_="+Date.now(),{cache:"no-store"});
      const d=await r.json();
      if(!d.success) return;

      updateCard("Total Revenue",money(d.total_revenue));
      updateCard("Today",money(d.today_revenue));
      updateCard("Paid Sessions",d.paid);
      updateCard("Pending / Failed",d.pending+" / "+d.failed);

      const table=[...document.querySelectorAll("table")].find(t=>{
        const x=t.innerText||"";
        return x.includes("Phone") && x.includes("Checkout") && x.includes("Client IP");
      });

      if(table){
        const tbody=table.querySelector("tbody");
        if(tbody){
          tbody.innerHTML=d.rows.map(row=>`
            <tr>
              <td>${row.id||""}</td>
              <td>${row.phone||"-"}</td>
              <td>KES ${Number(row.amount||0).toLocaleString()}</td>
              <td>${badge(row.status)}</td>
              <td>${row.mpesa_receipt || row.reference || "-"}</td>
              <td style="max-width:250px;overflow:hidden;text-overflow:ellipsis">${row.checkout_id || "-"}</td>
              <td>${row.client_ip || "-"}</td>
              <td>${row.created_at || "-"}</td>
              <td>${row.expires_at || "-"}</td>
            </tr>
          `).join("");
        }
      }

      let live=document.getElementById("stkLiveTime");
      if(!live){
        live=document.createElement("div");
        live.id="stkLiveTime";
        live.className="stk-live-time";
        live.innerHTML="";
        const h=[...document.querySelectorAll("h1,h2")].find(x=>(x.textContent||"").includes("Live STK"));
        if(h) h.insertAdjacentElement("afterend",live);
      }
      live.textContent="Live updated: "+d.time+" • refresh every 10s";

    }catch(e){}
  }

  syncSTK();
  setInterval(syncSTK,10000);
});
</script>
