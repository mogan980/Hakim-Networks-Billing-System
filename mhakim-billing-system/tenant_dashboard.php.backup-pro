<script>
function money(v){
    return "KES " + Number(v || 0).toLocaleString();
}

async function liveTenant(){
    try{
        const r = await fetch("/mhakim-billing-system/tenant/tenant_live.php?t=" + Date.now(), {cache:"no-store"});
        const d = await r.json();

        ["clients","active_clients","expired_clients","packages","vouchers","unused_vouchers"].forEach(id=>{
            const el=document.getElementById(id);
            if(el) el.innerText=d[id] ?? 0;
        });

        document.getElementById("today_revenue").innerText = money(d.today_revenue);
        document.getElementById("total_revenue").innerText = money(d.total_revenue);
        document.getElementById("updated_at").innerText = d.updated_at;
    }catch(e){
        console.log("tenant live update failed");
    }
}

liveTenant();
setInterval(liveTenant, 10000);
</script>

