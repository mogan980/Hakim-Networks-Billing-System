<?php
session_start();
require_once "config/database.php";

if (($_SESSION["tenant_role"] ?? "") !== "super_admin") {
    header("Location: saas_auth.php");
    exit;
}

$msg = "";

if (isset($_GET["delete"])) {
    $id = (int)$_GET["delete"];

    $pdo->prepare("DELETE FROM tenant_users WHERE company_id=?")->execute([$id]);
    $pdo->prepare("DELETE FROM subscriptions WHERE company_id=?")->execute([$id]);
    $pdo->prepare("DELETE FROM companies WHERE id=?")->execute([$id]);

    $msg = "Tenant deleted successfully.";
}

if (isset($_GET["suspend"])) {
    $id = (int)$_GET["suspend"];
    $pdo->prepare("UPDATE companies SET status='suspended' WHERE id=?")->execute([$id]);
    $msg = "Tenant suspended.";
}

if (isset($_GET["activate"])) {
    $id = (int)$_GET["activate"];
    $expires = date("Y-m-d H:i:s", strtotime("+1 month"));

    $pdo->prepare("UPDATE companies SET status='active' WHERE id=?")->execute([$id]);

    $pdo->prepare("
        INSERT INTO subscriptions(company_id, amount, status, starts_at, expires_at, created_at)
        VALUES(?,1000,'active',NOW(),?,NOW())
    ")->execute([$id, $expires]);

    $msg = "Tenant activated for 1 month.";
}

if (isset($_GET["disconnect"])) {
    $id = (int)$_GET["disconnect"];

    $pdo->prepare("
        UPDATE companies
        SET router_ip=NULL, router_user=NULL, router_pass=NULL
        WHERE id=?
    ")->execute([$id]);

    $pdo->prepare("
        INSERT INTO tenant_router_logs(company_id,action_type,router_ip,message)
        VALUES(?,'admin_disconnect','','Super admin disconnected tenant router')
    ")->execute([$id]);

    $msg = "Tenant router disconnected.";
}

$tenants = $pdo->query("
    SELECT 
        c.*,
        u.full_name,
        u.email AS user_email,
        u.phone AS user_phone,
        u.status AS user_status,
        s.status AS sub_status,
        s.expires_at,
        (
            SELECT COUNT(*) FROM clients WHERE company_id=c.id
        ) AS total_clients,
        (
            SELECT COALESCE(SUM(amount),0) FROM payments WHERE company_id=c.id AND status='paid'
        ) AS total_revenue,
        (
            SELECT COUNT(*) FROM vouchers WHERE company_id=c.id
        ) AS total_vouchers
    FROM companies c
    LEFT JOIN tenant_users u ON u.company_id=c.id
    LEFT JOIN subscriptions s ON s.company_id=c.id
    WHERE u.role IS NULL OR u.role != 'super_admin'
    ORDER BY c.id DESC
")->fetchAll(PDO::FETCH_ASSOC);
?>
