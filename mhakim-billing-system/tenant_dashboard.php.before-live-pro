<?php
require_once __DIR__ . "/access_guard.php";
require_once __DIR__ . "/config/database.php";

if (($_SESSION["tenant_role"] ?? "") === "super_admin") {
    header("Location: noc_final_clean.php");
    exit;
}

$companyId = $_SESSION["tenant_company_id"];
$name = $_SESSION["tenant_name"] ?? "Client";

$countClients = $pdo->prepare("SELECT COUNT(*) FROM clients WHERE company_id=?");
$countClients->execute([$companyId]);

$countPackages = $pdo->prepare("SELECT COUNT(*) FROM packages WHERE company_id=?");
$countPackages->execute([$companyId]);

$countVouchers = $pdo->prepare("SELECT COUNT(*) FROM vouchers WHERE company_id=?");
$countVouchers->execute([$companyId]);

$totalRevenue = $pdo->prepare("SELECT COALESCE(SUM(amount),0) FROM payments WHERE company_id=? AND status='paid'");
$totalRevenue->execute([$companyId]);
