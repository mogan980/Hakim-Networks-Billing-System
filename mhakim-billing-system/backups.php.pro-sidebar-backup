<script>
function showBackupTab(tab, btn){
    document.querySelectorAll(".tab-content").forEach(el => el.classList.remove("active"));
    document.querySelectorAll(".tab-btn").forEach(el => el.classList.remove("active"));

    document.getElementById("tab-" + tab).classList.add("active");
    btn.classList.add("active");
}
</script>
<script>
async function checkRouterHealth(){
    try{
        const res = await fetch("router_health.php");
        const data = await res.json();

        const text = document.getElementById("routerStatusText");
        const dot = document.getElementById("routerDot");
        const last = document.getElementById("routerLastCheck");

        if(data.status === "online"){
            text.innerText = "Online";
            text.style.color = "#22c55e";
            dot.style.background = "#22c55e";
        }else{
            text.innerText = "Offline";
            text.style.color = "#ef4444";
            dot.style.background = "#ef4444";
        }

        last.innerText = "Last Check: " + (data.time || "--");

    }catch(e){
        document.getElementById("routerStatusText").innerText = "Error";
    }
}

checkRouterHealth();
setInterval(checkRouterHealth, 10000);
</script>
<script>
const wanCanvas = document.getElementById("wanTrafficChart");
let wanChart = null;

if (wanCanvas) {
    wanChart = new Chart(wanCanvas, {
        type: "line",
        data: {
            labels: [],
            datasets: [
                {
                    label: "Download RX Mbps",
                    data: [],
                    borderColor: "#22c55e",
                    backgroundColor: "rgba(34,197,94,0.12)",
                    tension: 0.35,
                    borderWidth: 3
                },
                {
                    label: "Upload TX Mbps",
                    data: [],
                    borderColor: "#3b82f6",
                    backgroundColor: "rgba(59,130,246,0.12)",
                    tension: 0.35,
                    borderWidth: 3
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: false,
            scales: {
                y: { beginAtZero: true }
            }
        }
    });
}

async function updateWanGraph(){
    try{
        const res = await fetch("wan_stats.php");
        const data = await res.json();

        if(!data.success) return;

        document.getElementById("wanRx").innerText = data.rx_mbps + " Mbps";
        document.getElementById("wanTx").innerText = data.tx_mbps + " Mbps";

        if(wanChart){
            wanChart.data.labels.push(data.time);
            wanChart.data.datasets[0].data.push(data.rx_mbps);
            wanChart.data.datasets[1].data.push(data.tx_mbps);

            if(wanChart.data.labels.length > 15){
                wanChart.data.labels.shift();
                wanChart.data.datasets[0].data.shift();
                wanChart.data.datasets[1].data.shift();
            }

            wanChart.update();
        }

    }catch(e){
        console.log("WAN graph error", e);
    }
}

updateWanGraph();
setInterval(updateWanGraph, 5000);
</script>
