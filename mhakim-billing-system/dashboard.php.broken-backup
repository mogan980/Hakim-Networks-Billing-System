        const time = document.getElementById("live-time");

        if (rx) {
            rx.innerText = data.rx_mbps + " Mbps";
        }

        if (tx) {
            tx.innerText = data.tx_mbps + " Mbps";
        }

        // Example WAN capacity = 100 Mbps
        let usagePercent = Math.round(
            ((data.rx_mbps + data.tx_mbps) / 100) * 100
        );

        if (usage) {
            usage.innerText = usagePercent + "%";
usage.classList.remove("badge-green", "badge-orange", "badge-red");

if (usagePercent < 50) {
    usage.classList.add("badge-green");
} else if (usagePercent < 80) {
    usage.classList.add("badge-orange");
} else {
    usage.classList.add("badge-red");
}
        }

        if (time) {
            time.innerText = data.time;
        }

    } catch(err) {
