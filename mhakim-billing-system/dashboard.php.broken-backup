use RouterOS\Client;
use RouterOS\Config;
use RouterOS\Query;

if (!isset($_SESSION["user_id"])) {
    header("Location: login.php");
    exit;
}

$totalClients = $pdo->query("SELECT COUNT(*) FROM clients")->fetchColumn();
$activeClients = $pdo->query("SELECT COUNT(*) FROM clients WHERE status='active'")->fetchColumn();
$expiredClients = $pdo->query("SELECT COUNT(*) FROM clients WHERE status='expired'")->fetchColumn();
$blockedClients = $pdo->query("SELECT COUNT(*) FROM clients WHERE status='blocked'")->fetchColumn();

$totalPayments = $pdo->query("SELECT COALESCE(SUM(amount),0) FROM payments WHERE status='paid'")->fetchColumn();
$todayRevenue = $pdo->query("SELECT COALESCE(SUM(amount),0) FROM payments WHERE status='paid' AND DATE(created_at)=CURDATE()")->fetchColumn();
$monthlyRevenue = $pdo->query("SELECT COALESCE(SUM(amount),0) FROM payments WHERE status='paid' AND MONTH(created_at)=MONTH(CURDATE()) AND YEAR(created_at)=YEAR(CURDATE())")->fetchColumn();

$totalPackages = $pdo->query("SELECT COUNT(*) FROM packages WHERE status='active'")->fetchColumn();
$totalVouchers = $pdo->query("SELECT COUNT(*) FROM vouchers")->fetchColumn();
$unusedVouchers = $pdo->query("SELECT COUNT(*) FROM vouchers WHERE status='unused'")->fetchColumn();
$usedVouchers = $pdo->query("SELECT COUNT(*) FROM vouchers WHERE status='used'")->fetchColumn();

$averageRevenuePerUser = $totalClients > 0 ? $totalPayments / $totalClients : 0;
$collectionRate = $totalClients > 0 ? round(($activeClients / $totalClients) * 100) : 0;

$mikrotikConnected = false;
$hotspotUsersCount = 0;
$onlineUsers = 0;
$queuesCount = 0;
$routerName = "Unknown";
$routerUptime = "Offline";
$cpuLoad = 0;
$freeMemory = "-";
$totalMemory = "-";
$freeHdd = "-";
$architecture = "-";
$boardName = "-";
$rxBps = 0;
$txBps = 0;
$signalQuality = 0;
$wirelessClients = 0;
$avgSignal = "N/A";
$networkStrength = 0;

function formatBits($bps) {
    $bps = (float)$bps;
    if ($bps >= 1000000) return round($bps / 1000000, 2) . " Mbps";
    if ($bps >= 1000) return round($bps / 1000, 2) . " Kbps";
    return round($bps) . " bps";
}

// Fast cached MikroTik stats from system_stats table
$stats = $pdo->query("SELECT * FROM system_stats WHERE id=1")->fetch(PDO::FETCH_ASSOC);

$mikrotikConnected = (($stats["router_status"] ?? "offline") === "online");
$routerName = "MikroTik";
$routerUptime = $stats["updated_at"] ?? "-";
$onlineUsers = (int)($stats["online_hotspot"] ?? 0);
$hotspotUsersCount = $onlineUsers;
$queuesCount = 0;
$rxBps = ((float)($stats["wan_rx"] ?? 0)) * 1000000;
$txBps = ((float)($stats["wan_tx"] ?? 0)) * 1000000;
$networkStrength = $mikrotikConnected ? 90 : 0;
$signalQuality = $mikrotikConnected ? 80 : 0;
$wirelessClients = $onlineUsers;
$avgSignal = $mikrotikConnected ? "Cached" : "N/A";
$cpuLoad = 0;
$freeMemory = "-";
$totalMemory = "-";
$freeHdd = "-";
$architecture = "-";
$boardName = "-";

$labels = [];
$values = [];

$paymentsChart = $pdo->query("
    SELECT DATE(created_at) as day, SUM(amount) as total
    FROM payments
    WHERE status='paid'
    GROUP BY DATE(created_at)
    ORDER BY DATE(created_at) ASC
    LIMIT 7
")->fetchAll(PDO::FETCH_ASSOC);

foreach($paymentsChart as $row){
    $labels[] = $row["day"];
    $values[] = $row["total"];
}

$packageLabels = [];
$packageValues = [];

$packageChart = $pdo->query("
    SELECT packages.name, COUNT(clients.id) AS total_clients
    FROM packages
    LEFT JOIN clients ON clients.package_id = packages.id
    GROUP BY packages.id
    ORDER BY total_clients DESC
")->fetchAll(PDO::FETCH_ASSOC);

foreach($packageChart as $row){
    $packageLabels[] = $row["name"];
    $packageValues[] = $row["total_clients"];
}
?>
