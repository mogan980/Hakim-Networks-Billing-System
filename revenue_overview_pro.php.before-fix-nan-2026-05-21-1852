function val($pdo,$sql){
    $v = $pdo->query($sql)->fetchColumn();
    return $v === false || $v === null ? 0 : $v;
}

$today = (float)val($pdo,"SELECT COALESCE(SUM(amount),0) FROM payments WHERE status='paid' AND DATE(created_at)=CURDATE()");
$week  = (float)val($pdo,"SELECT COALESCE(SUM(amount),0) FROM payments WHERE status='paid' AND YEARWEEK(created_at,1)=YEARWEEK(CURDATE(),1)");
$month = (float)val($pdo,"SELECT COALESCE(SUM(amount),0) FROM payments WHERE status='paid' AND MONTH(created_at)=MONTH(CURDATE()) AND YEAR(created_at)=YEAR(CURDATE())");
$total = (float)val($pdo,"SELECT COALESCE(SUM(amount),0) FROM payments WHERE status='paid'");

$clients  = (int)val($pdo,"SELECT COUNT(*) FROM clients");
$packages = (int)val($pdo,"SELECT COUNT(*) FROM packages");
$vouchers = (int)val($pdo,"SELECT COUNT(*) FROM smart_vouchers");

function money($n){ return "Ksh " . number_format((float)$n,0); }

$max = max($today,$week,$month,$total,1);
?>
