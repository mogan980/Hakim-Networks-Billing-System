<?php
session_start();
require_once "config/database.php";

$companyId = (int)($_GET["company_id"] ?? ($_SESSION["tenant_company_id"] ?? 0));

if (!$companyId) {
    header("Location: saas_auth.php");
    exit;
}

$stmt = $pdo->prepare("SELECT * FROM companies WHERE id=? LIMIT 1");
$stmt->execute([$companyId]);
$company = $stmt->fetch(PDO::FETCH_ASSOC);

if (!$company) {
    die("Company not found.");
}

if ($_SERVER["REQUEST_METHOD"] === "POST") {
    // Temporary manual activation button for testing.
    // Later this will be replaced with real M-Pesa callback.
    $expires = date("Y-m-d H:i:s", strtotime("+1 month"));

    $pdo->prepare("
        INSERT INTO subscriptions(company_id, amount, status, starts_at, expires_at, created_at)
        VALUES(?, 1000, 'paid', NOW(), ?, NOW())
    ")->execute([$companyId, $expires]);

    $pdo->prepare("UPDATE companies SET status='active' WHERE id=?")->execute([$companyId]);

    $u = $pdo->prepare("
        SELECT *
        FROM tenant_users
        WHERE company_id=?
        ORDER BY id DESC
        LIMIT 1
    ");

    $u->execute([$companyId]);

    $user = $u->fetch(PDO::FETCH_ASSOC);

    if ($user) {

        $_SESSION["tenant_user_id"] = $user["id"];
        $_SESSION["tenant_role"] = $user["role"];
        $_SESSION["tenant_company_id"] = $user["company_id"];
        $_SESSION["tenant_name"] = $user["full_name"];

        $_SESSION["user_id"] = $user["id"];
        $_SESSION["role"] = $user["role"];
        $_SESSION["name"] = $user["full_name"];
    }

    header("Location: tenant_noc_final_clean.php");
    exit;
}
