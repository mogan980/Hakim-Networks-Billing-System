<?php
date_default_timezone_set("Africa/Nairobi");
require_once __DIR__ . "/config/database.php";

function dbv($pdo,$sql){
    $v = $pdo->query($sql)->fetchColumn();
    return $v === false || $v === null ? 0 : $v;
}
function cash($n){ return "Ksh " . number_format((float)$n,0); }

$total = dbv($pdo,"SELECT COALESCE(SUM(amount),0) FROM payments WHERE status='paid'");
$month = dbv($pdo,"SELECT COALESCE(SUM(amount),0) FROM payments WHERE status='paid' AND MONTH(created_at)=MONTH(CURDATE()) AND YEAR(created_at)=YEAR(CURDATE())");
$today = dbv($pdo,"SELECT COALESCE(SUM(amount),0) FROM payments WHERE status='paid' AND DATE(created_at)=CURDATE()");
$stk = dbv($pdo,"SELECT COALESCE(SUM(amount),0) FROM payments WHERE status='paid' AND method IN ('mpesa','stk','M-PESA')");
$voucher = dbv($pdo,"SELECT COALESCE(SUM(amount),0) FROM payments WHERE status='paid' AND method='voucher'");
$pppoe = dbv($pdo,"SELECT COALESCE(SUM(amount),0) FROM payments WHERE status='paid' AND method='pppoe'");
$hotspot = dbv($pdo,"SELECT COALESCE(SUM(amount),0) FROM payments WHERE status='paid' AND (method='hotspot' OR method='cash')");

$max = max($today,$month,$total,$stk,$voucher,$pppoe,$hotspot,1);
?>
