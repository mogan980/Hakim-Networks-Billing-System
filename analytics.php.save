<?php
session_start();

require_once "config/database.php";

if(
    !isset($_SESSION["tenant_user_id"])
    &&
    !isset($_SESSION["user_id"])
){
    header("Location: saas_auth.php");
    exit;
}

$totalClients = $pdo->query("SELECT COUNT(*) FROM clients")->fetchColumn();

$totalRevenue = $pdo->query("
    SELECT COALESCE(SUM(amount),0)
    FROM payments
    WHERE status='paid'
")->fetchColumn();

$totalVouchers = $pdo->query("
    SELECT COUNT(*)
    FROM vouchers
")->fetchColumn();

$activeClients = $pdo->query("
    SELECT COUNT(*)
    FROM clients
    WHERE status='active'
")->fetchColumn();

$paymentsChart = $pdo->query("
    SELECT DATE(created_at) as day,
    SUM(amount) as total
    FROM payments
    WHERE status='paid'
    GROUP BY DATE(created_at)
    ORDER BY day ASC
    LIMIT 7
")->fetchAll(PDO::FETCH_ASSOC);

$labels = [];
$values = [];

foreach($paymentsChart as $row){
    $labels[] = $row["day"];
    $values[] = $row["total"];
}
?>
