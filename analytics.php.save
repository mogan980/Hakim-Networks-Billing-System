<script>
async function loadAnalytics(){
    const res = await fetch("analytics_data.php?t=" + Date.now());
    const data = await res.json();

    drawRevenueChart(data.revenue);
    drawClientChart(data.client_status);
    drawPackageChart(data.packages);
}

let revenueChart, clientChart, packageChart;

function drawRevenueChart(rows){
    const labels = rows.map(r => r.day);
    const values = rows.map(r => Number(r.total));

    if(revenueChart) revenueChart.destroy();

    revenueChart = new Chart(document.getElementById("revenueChart"), {
        type: "line",
        data: {
            labels,
            datasets: [{
                label: "Revenue KES",
                data: values,
                borderColor: "#22c55e",
                backgroundColor: "rgba(34,197,94,.15)",
                fill: true,
                tension: .35
            }]
        },
        options: {responsive:true, plugins:{legend:{labels:{color:"#fff"}}}, scales:{x:{ticks:{color:"#cbd5e1"}}, y:{ticks:{color:"#cbd5e1"}}}}
    });
}

function drawClientChart(rows){
    const labels = rows.map(r => r.status);
    const values = rows.map(r => Number(r.total));

    if(clientChart) clientChart.destroy();

    clientChart = new Chart(document.getElementById("clientChart"), {
        type: "doughnut",
        data: {
            labels,
            datasets: [{data: values}]
        },
        options: {responsive:true, plugins:{legend:{labels:{color:"#fff"}}}}
    });
}

function drawPackageChart(rows){
    const labels = rows.map(r => r.name || "Unknown");
    const values = rows.map(r => Number(r.total));

    if(packageChart) packageChart.destroy();

    packageChart = new Chart(document.getElementById("packageChart"), {
        type: "bar",
        data: {
            labels,
            datasets: [{
                label: "Users",
                data: values,
                backgroundColor: "rgba(34,197,94,.6)"
            }]
        },
        options: {responsive:true, plugins:{legend:{labels:{color:"#fff"}}}, scales:{x:{ticks:{color:"#cbd5e1"}}, y:{ticks:{color:"#cbd5e1"}}}}
    });
}

loadAnalytics();
setInterval(loadAnalytics, 30000);
</script>
<script>
let wanChart;

async function loadWanGraph(){
    const res = await fetch("analytics_data.php?t=" + Date.now());
    const data = await res.json();

    const rx = Number(data.stats.wan_rx || 0);
    const tx = Number(data.stats.wan_tx || 0);
    const time = data.stats.updated_at || new Date().toLocaleTimeString();

    document.getElementById("wanRx").innerText = rx + " Mbps";
    document.getElementById("wanTx").innerText = tx + " Mbps";

    if(!wanChart){
        wanChart = new Chart(document.getElementById("wanChart"), {
            type: "line",
            data: {
                labels: [],
                datasets: [
                    {label:"Download RX", data:[], borderColor:"#22c55e", tension:.35},
                    {label:"Upload TX", data:[], borderColor:"#3b82f6", tension:.35}
                ]
            },
            options: {
                responsive:true,
                plugins:{legend:{labels:{color:"#fff"}}},
                scales:{
                    x:{ticks:{color:"#cbd5e1"}},
                    y:{ticks:{color:"#cbd5e1"}, beginAtZero:true}
                }
            }
        });
    }

    wanChart.data.labels.push(time);
    wanChart.data.datasets[0].data.push(rx);
    wanChart.data.datasets[1].data.push(tx);

    if(wanChart.data.labels.length > 20){
        wanChart.data.labels.shift();
        wanChart.data.datasets[0].data.shift();
        wanChart.data.datasets[1].data.shift();
    }

    wanChart.update();
}

loadWanGraph();
setInterval(loadWanGraph, 30000);
</script>
<div class="section">
    <h2>Real-Time Online Users</h2>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:15px;">
        <div class="card">
            <h3>Hotspot Online</h3>
            <div class="value" id="liveHotspot">0</div>
        </div>

        <div class="card">
            <h3>PPPoE Online</h3>
            <div class="value" id="livePppoe">0</div>
        </div>
    </div>
</div>
<script>
async function loadOnlineUsers(){
    const res = await fetch("analytics_data.php?t=" + Date.now());
    const data = await res.json();

    document.getElementById("liveHotspot").innerText =
        data.stats.online_hotspot || 0;

    document.getElementById("livePppoe").innerText =
        data.stats.online_pppoe || 0;
}

loadOnlineUsers();

setInterval(loadOnlineUsers, 30000);
</script>
