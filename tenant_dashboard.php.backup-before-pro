$companyId = $_SESSION["tenant_company_id"] ?? 0;
$name = $_SESSION["tenant_name"] ?? "Tenant";

function countData($pdo, $sql, $companyId){
    $stmt = $pdo->prepare($sql);
    $stmt->execute([$companyId]);
    return $stmt->fetchColumn();
}

$totalClients = countData($pdo, "SELECT COUNT(*) FROM clients WHERE company_id=?", $companyId);
$totalPackages = countData($pdo, "SELECT COUNT(*) FROM packages WHERE company_id=?", $companyId);
$totalVouchers = countData($pdo, "SELECT COUNT(*) FROM vouchers WHERE company_id=?", $companyId);
$totalRevenue = countData($pdo, "SELECT COALESCE(SUM(amount),0) FROM payments WHERE company_id=? AND status='paid'", $companyId);
?>
