<script>
async function refreshTenant(){
    try{
        const r = await fetch("tenant/tenant_live.php?t="+Date.now(), {cache:"no-store"});
        const d = await r.json();
        document.getElementById("clients").innerText=d.clients;
        document.getElementById("packages").innerText=d.packages;
        document.getElementById("vouchers").innerText=d.vouchers;
        document.getElementById("revenue").innerText="KES "+Number(d.total_revenue).toLocaleString();
    }catch(e){}
}
setInterval(refreshTenant,10000);

async function loadRouterLive(){

    try{

        const r = await fetch("tenant/tenant_router_live.php?t="+Date.now(),{
            cache:"no-store"
        });

        const d = await r.json();

        document.getElementById("router_status").innerText =
            d.status === "online" ? "ONLINE" : "OFFLINE";

        document.getElementById("cpu_load").innerText =
            (d.cpu_load || 0) + "%";

        document.getElementById("hotspot_users").innerText =
            d.active_hotspot_users || 0;

        document.getElementById("queues").innerText =
            d.simple_queues || 0;

        document.getElementById("router_name_live").innerText =
            d.router_name || "-";

        document.getElementById("board_live").innerText =
            d.board || "-";

        document.getElementById("uptime_live").innerText =
            d.uptime || "-";

        document.getElementById("memory_live").innerText =
            d.free_memory || "-";

        document.getElementById("updated_live").innerText =
            d.updated_at || "-";

    }catch(e){
        console.log(e);
    }
}

loadRouterLive();

setInterval(loadRouterLive, 10000);

</script>
