use RouterOS\Client;
use RouterOS\Query;

$message = "";

function h($v){ return htmlspecialchars((string)$v, ENT_QUOTES, "UTF-8"); }

function mt_client(){
    $config = require __DIR__ . "/config/mikrotik.php";
    $hosts = array_unique([
        $config["host"] ?? "192.168.88.1",
        "192.168.88.1",
        "10.10.10.1"
    ]);

    foreach($hosts as $host){
        try{
            return new Client([
                "host"=>$host,
                "user"=>$config["user"],
                "pass"=>$config["pass"],
                "port"=>$config["port"],
                "timeout"=>5
            ]);
        }catch(Exception $e){}
    }

    return null;
}

function disconnect_ip($client, $ip){
    if(!$client || !$ip) return false;

    $done = false;

    try{
        $active = $client->query(
            (new Query("/ip/hotspot/active/print"))->where("address",$ip)
        )->read();

        foreach($active as $a){
            if(isset($a[".id"])){
                $client->query(
                    (new Query("/ip/hotspot/active/remove"))->equal(".id",$a[".id"])
                )->read();
                $done = true;
            }
        }
    }catch(Exception $e){}

    try{
        $queues = $client->query(new Query("/queue/simple/print"))->read();

        foreach($queues as $q){
            $target = $q["target"] ?? "";
            if(str_contains($target, $ip) && isset($q[".id"])){
                $client->query(
                    (new Query("/queue/simple/remove"))->equal(".id",$q[".id"])
                )->read();
                $done = true;
            }
        }
    }catch(Exception $e){}

    return $done;
}

$client = mt_client();

if($_SERVER["REQUEST_METHOD"] === "POST"){
    $action = $_POST["action"] ?? "";
    $id = (int)($_POST["id"] ?? 0);

    $stmt = $pdo->prepare("SELECT * FROM smart_vouchers WHERE id=? LIMIT 1");
    $stmt->execute([$id]);
    $voucher = $stmt->fetch(PDO::FETCH_ASSOC);

    if($voucher){
        $ip = trim($voucher["used_by"] ?? "");

        if($action === "disconnect"){
            disconnect_ip($client, $ip);
            $pdo->prepare("UPDATE smart_vouchers SET online_status='offline' WHERE id=?")->execute([$id]);
            $message = "User disconnected from MikroTik.";
        }

        if($action === "delete"){
            disconnect_ip($client, $ip);
            $pdo->prepare("DELETE FROM smart_vouchers WHERE id=?")->execute([$id]);
            $message = "Voucher deleted and user disconnected.";
        }

        if($action === "extend"){
            $hours = max(1, (int)($_POST["hours"] ?? 1));
            $pdo->prepare("
                UPDATE smart_vouchers 
                SET expires_at = DATE_ADD(GREATEST(COALESCE(expires_at,NOW()), NOW()), INTERVAL ? HOUR),
                    status='used'
                WHERE id=?
            ")->execute([$hours,$id]);
            $message = "Expiry extended by {$hours} hour(s).";
        }

        if($action === "clean_one"){
            disconnect_ip($client, $ip);
            $pdo->prepare("UPDATE smart_vouchers SET status='expired', online_status='offline' WHERE id=?")->execute([$id]);
            $message = "Expired user cleaned from WiFi.";
        }
    }
}

if(isset($_GET["run_clean"])){
    $expired = $pdo->query("
        SELECT * FROM smart_vouchers
        WHERE status='used'
        AND expires_at IS NOT NULL
        AND expires_at <= NOW()
    ")->fetchAll(PDO::FETCH_ASSOC);

    $cleaned = 0;

    foreach($expired as $v){
        $ip = trim($v["used_by"] ?? "");
        if(disconnect_ip($client, $ip)){
            $cleaned++;
        }

        $pdo->prepare("UPDATE smart_vouchers SET status='expired', online_status='offline' WHERE id=?")
            ->execute([$v["id"]]);
    }

    $message = "Auto clean complete. Cleaned {$cleaned} expired online user(s).";
}

$onlineIps = [];

if($client){
    try{
        $active = $client->query(new Query("/ip/hotspot/active/print"))->read();
        foreach($active as $a){
            if(!empty($a["address"])) $onlineIps[$a["address"]] = true;
        }
    }catch(Exception $e){}
}

$rows = $pdo->query("
    SELECT *
    FROM smart_vouchers
    ORDER BY 
      CASE 
        WHEN status='used' AND expires_at IS NOT NULL AND expires_at <= NOW() THEN 0
        WHEN status='used' THEN 1
        ELSE 2
      END,
      id DESC
")->fetchAll(PDO::FETCH_ASSOC);

$activeCount = 0;
$expiredWaiting = 0;
$expiredTotal = 0;

foreach($rows as $r){
    $ip = trim($r["used_by"] ?? "");
    $online = $ip && isset($onlineIps[$ip]);
    $expired = !empty($r["expires_at"]) && strtotime($r["expires_at"]) <= time();

    if(($r["status"] ?? "") === "used" && !$expired) $activeCount++;
    if(($r["status"] ?? "") === "used" && $expired && $online) $expiredWaiting++;
    if(($r["status"] ?? "") === "expired") $expiredTotal++;
}
