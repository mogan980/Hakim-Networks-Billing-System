        </div>
        <div class="row">
            <span class="label">Expires</span>
            <span class="value"><?php echo htmlspecialchars($expires_at); ?></span>
        </div>
    </div>

    <form id="hotspotLogin" action="http://login.hakim/login" method="post">
        <input type="hidden" name="username" value="<?php echo htmlspecialchars($username); ?>">
        <input type="hidden" name="password" value="<?php echo htmlspecialchars($password); ?>">
        <input type="hidden" name="dst" value="http://neverssl.com">
        <input type="hidden" name="popup" value="false">
        <button class="btn" type="submit">Connect Internet Now</button>
