            <span class="label">Package</span>
            <span class="value"><?php echo htmlspecialchars($voucher["package_name"]); ?></span>
        </div>
        <div class="row">
            <span class="label">Username</span>
            <span class="value"><?php echo htmlspecialchars($username); ?></span>
        </div>
        <div class="row">
