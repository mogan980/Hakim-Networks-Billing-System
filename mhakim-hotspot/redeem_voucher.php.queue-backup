<?php
date_default_timezone_set("Africa/Nairobi");

require_once "/var/www/html/mhakim-billing-system/config/database.php";
require_once "/var/www/html/mhakim-billing-system/vendor/autoload.php";

use RouterOS\Client;
use RouterOS\Config;
use RouterOS\Query;

$voucher_code = strtoupper(trim($_POST["voucher_code"] ?? ""));

if (!$voucher_code) {
    die("Voucher code missing");
}

try {
    $pdo->beginTransaction();

    $voucherQuery = $pdo->prepare("
        SELECT 
            vouchers.*,
            packages.name AS package_name,
            packages.duration_hours,
            packages.speed_down,
            packages.speed_up,
            packages.price
        FROM vouchers
        LEFT JOIN packages ON vouchers.package_id = packages.id
        WHERE vouchers.code = ?
        AND vouchers.status = 'unused'
        LIMIT 1
    ");
    $voucherQuery->execute([$voucher_code]);
    $voucher = $voucherQuery->fetch(PDO::FETCH_ASSOC);

    if (!$voucher) {
        throw new Exception("Invalid or already used voucher.");
    }

    $username = $voucher_code;
    $password = $voucher_code;
    $duration_minutes = round($voucher["duration_hours"] * 60);

    $insertClient = $pdo->prepare("
        INSERT INTO clients
        (full_name, phone, username, password, package_id, status, starts_at, expires_at)
        VALUES
        ('Voucher User', '', ?, ?, ?, 'active', NOW(), DATE_ADD(NOW(), INTERVAL ? MINUTE))
    ");
    $insertClient->execute([
        $username,
        $password,
        $voucher["package_id"],
        $duration_minutes
    ]);

    $client_id = $pdo->lastInsertId();

    $settings = $pdo->query("
        SELECT * FROM mikrotik_settings 
        ORDER BY id DESC 
        LIMIT 1
    ")->fetch(PDO::FETCH_ASSOC);

    if (!$settings) {
        throw new Exception("MikroTik settings missing.");
    }

    $api = new Client(new Config([
        'host' => $settings["router_ip"],
        'user' => $settings["router_username"],
        'pass' => $settings["router_password"],
        'port' => (int)$settings["api_port"],
    ]));

    $findUser = (new Query('/ip/hotspot/user/print'))->where('name', $username);
    $foundUsers = $api->query($findUser)->read();

    if (!empty($foundUsers)) {
        $userId = $foundUsers[0][".id"];

        $api->query(
            (new Query('/ip/hotspot/user/set'))
                ->equal('.id', $userId)
                ->equal('password', $password)
                ->equal('profile', 'default')
                ->equal('disabled', 'no')
        )->read();
    } else {
        $api->query(
            (new Query('/ip/hotspot/user/add'))
                ->equal('name', $username)
                ->equal('password', $password)
                ->equal('profile', 'default')
        )->read();
    }

    $pdo->prepare("
        UPDATE vouchers 
        SET status='used', used_by_client_id=?, used_at=NOW()
        WHERE id=?
    ")->execute([$client_id, $voucher["id"]]);

    $pdo->prepare("
        INSERT INTO payments(client_id, package_id, amount, method, reference, status)
        VALUES (?, ?, ?, 'voucher', ?, 'paid')
    ")->execute([
        $client_id,
        $voucher["package_id"],
        $voucher["price"],
        $voucher_code
    ]);

    $expiryQuery = $pdo->prepare("SELECT expires_at FROM clients WHERE id=?");
    $expiryQuery->execute([$client_id]);
    $expires_at = $expiryQuery->fetchColumn();

    $pdo->commit();

} catch (Exception $e) {
    if ($pdo->inTransaction()) {
        $pdo->rollBack();
    }

    echo "<h1 style='color:red;font-family:Arial'>Voucher Activation Failed</h1>";
    echo "<p style='font-family:Arial'>" . htmlspecialchars($e->getMessage()) . "</p>";
    exit;
}
?>
<!DOCTYPE html>
<html>
<head>
    <title>Voucher Activated - M.Hakim</title>

    <script>
        setTimeout(function(){
            document.getElementById("hotspotLogin").submit();
