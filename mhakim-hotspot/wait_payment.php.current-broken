    <button class="btn" id="manualBtn" onclick="connectInternet()">Connect Internet</button>

    <div class="small">Checkout: <?php echo htmlspecialchars($checkout); ?></div>
</div>

<form id="loginForm" method="post" action="http://192.168.88.1/login" style="display:none;">
    <input type="hidden" name="username" id="username">
    <input type="hidden" name="password" id="password">
    <input type="hidden" name="dst" id="dst" value="http://neverssl.com/">
</form>

<script>
let tries = 0;
let ready = false;

function connectInternet(){
    if(!ready) return;
    document.getElementById("loginForm").submit();
}

async function checkPayment(){
    tries++;

    try{
        const r = await fetch("check_payment.php?checkout_id=<?php echo urlencode($checkout); ?>&t="+Date.now(), {cache:"no-store"});
        const d = await r.json();

        if(d.status === "paid"){
            document.getElementById("statusBox").innerHTML = "✅ Payment confirmed. Connecting internet...";
            document.getElementById("username").value = d.username || "";
            document.getElementById("password").value = d.password || "";

            if(d.login_url){
                document.getElementById("loginForm").action = d.login_url;
            }

            if(d.dst){
                document.getElementById("dst").value = d.dst;
            }

            ready = true;
            document.getElementById("manualBtn").style.display = "block";

            setTimeout(connectInternet, 1500);
            return;
        }

        if(d.status === "failed"){
            document.getElementById("statusBox").innerHTML = "❌ Payment failed. Redirecting...";
            setTimeout(()=>window.location.href="index.php",2500);
            return;
        }

        if(d.status === "error"){
            document.getElementById("statusBox").innerHTML = "Activation error: " + (d.message || "Unknown");
            setTimeout(checkPayment,3000);
            return;
        }

        document.getElementById("statusBox").innerHTML = "Waiting for confirmation... " + tries;
        setTimeout(checkPayment,2500);

    }catch(e){
        document.getElementById("statusBox").innerHTML = "Connection issue. Retrying... " + tries;
        setTimeout(checkPayment,2500);
    }
}

checkPayment();
</script>

