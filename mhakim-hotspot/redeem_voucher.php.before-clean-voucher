<?php
date_default_timezone_set("Africa/Nairobi");

require_once "/var/www/html/mhakim-billing-system/config/database.php";
require_once "/var/www/html/vendor/autoload.php";

use RouterOS\Client;
use RouterOS\Config;
use RouterOS\Query;

function logVoucher($msg){
    file_put_contents(
        __DIR__ . "/voucher_queue_error.log",
        "[" . date("Y-m-d H:i:s") . "] " . $msg . PHP_EOL,
        FILE_APPEND
    );
}

function speedValue($speed, $fallback){
    $speed = trim((string)$speed);
    if ($speed === "") return $fallback;
    if (preg_match('/^\d+$/', $speed)) return $speed . "M";
    return $speed;
}

$code = strtoupper(trim($_POST["voucher_code"] ?? ""));
$clientIp = $_POST["client_ip"] ?? ($_SERVER["REMOTE_ADDR"] ?? "");

if (!$code) {
    header("Location: index.php?error=Voucher code missing");
    exit;
}

try {

    $stmt = $pdo->prepare("
        SELECT vouchers.*, packages.name AS package_name, packages.duration_hours, packages.speed_down, packages.speed_up
        FROM vouchers
        LEFT JOIN packages ON vouchers.package_id = packages.id
        WHERE vouchers.code=?
        LIMIT 1
    ");
    $stmt->execute([$code]);
    $voucher = $stmt->fetch(PDO::FETCH_ASSOC);

    if (!$voucher) {
        throw new Exception("Invalid voucher");
    }

    if ($voucher["status"] === "used") {
        throw new Exception("Voucher already used");
    }

    $durationHours = (float)($voucher["duration_hours"] ?? 1);
    if ($durationHours <= 0) $durationHours = 1;

    $expiresAt = date("Y-m-d H:i:s", strtotime("+{$durationHours} hours"));

    $down = speedValue($voucher["speed_down"] ?? "", "6M");
    $up   = speedValue($voucher["speed_up"] ?? "", "2M");
    $maxLimit = $down . "/" . $up;

    $password = $code;

    $pdo->beginTransaction();

    $pdo->prepare("
        UPDATE vouchers
        SET status='used'
        WHERE id=?
    ")->execute([$voucher["id"]]);

    $clientStmt = $pdo->prepare("
        INSERT INTO clients
        (full_name, phone, username, password, package_id, status, starts_at, expires_at, client_ip, connection_type)
        VALUES ('Voucher User', '', ?, ?, ?, 'active', NOW(), ?, ?, 'hotspot')
        ON DUPLICATE KEY UPDATE
            password=VALUES(password),
            package_id=VALUES(package_id),
            status='active',
            starts_at=NOW(),
            expires_at=VALUES(expires_at),
            client_ip=VALUES(client_ip),
            connection_type='hotspot'
    ");

    $clientStmt->execute([
        $code,
        $password,
        $voucher["package_id"],
        $expiresAt,
        $clientIp
    ]);

    $pdo->commit();

    $settings = $pdo->query("
        SELECT *
        FROM mikrotik_settings
        ORDER BY id DESC
        LIMIT 1
    ")->fetch(PDO::FETCH_ASSOC);

    if (!$settings) {
        throw new Exception("MikroTik settings missing");
    }

    $api = new Client(new Config([
        "host" => $settings["router_ip"],
        "user" => $settings["router_username"],
        "pass" => $settings["router_password"],
        "port" => (int)$settings["api_port"],
        "timeout" => 5
    ]));

    $profileName = "VOUCHER-" . $down . "-" . $up;

    $profile = $api->query(
        (new Query("/ip/hotspot/user/profile/print"))
            ->where("name", $profileName)
    )->read();

    if (empty($profile)) {
        $api->query(
            (new Query("/ip/hotspot/user/profile/add"))
                ->equal("name", $profileName)
                ->equal("rate-limit", $maxLimit)
                ->equal("shared-users", "1")
        )->read();
    }

    $hotspotUser = $api->query(
        (new Query("/ip/hotspot/user/print"))
            ->where("name", $code)
    )->read();

    if (empty($hotspotUser)) {
        $api->query(
            (new Query("/ip/hotspot/user/add"))
                ->equal("name", $code)
                ->equal("password", $password)
                ->equal("profile", $profileName)
                ->equal("comment", "voucher:" . $code)
                ->equal("disabled", "no")
        )->read();
    } else {
        $api->query(
            (new Query("/ip/hotspot/user/set"))
                ->equal(".id", $hotspotUser[0][".id"])
                ->equal("password", $password)
                ->equal("profile", $profileName)
                ->equal("disabled", "no")
        )->read();
    }

    if ($clientIp && $clientIp !== "192.168.88.1") {
        $queueName = "CLIENT-" . $code;

        $queue = $api->query(
            (new Query("/queue/simple/print"))
                ->where("name", $queueName)
        )->read();

        if (empty($queue)) {
            $api->query(
                (new Query("/queue/simple/add"))
                    ->equal("name", $queueName)
                    ->equal("target", $clientIp . "/32")
                    ->equal("max-limit", $maxLimit)
                    ->equal("comment", "voucher:" . $code)
                    ->equal("disabled", "no")
            )->read();
        } else {
            $api->query(
                (new Query("/queue/simple/set"))
                    ->equal(".id", $queue[0][".id"])
                    ->equal("target", $clientIp . "/32")
                    ->equal("max-limit", $maxLimit)
                    ->equal("disabled", "no")
            )->read();
        }
    }


    if ($clientIp && $clientIp !== "192.168.88.1") {
        $binding = $api->query(
            (new Query("/ip/hotspot/ip-binding/print"))
                ->where("address", $clientIp)
        )->read();

        if (empty($binding)) {
            $api->query(
                (new Query("/ip/hotspot/ip-binding/add"))
                    ->equal("address", $clientIp)
                    ->equal("type", "bypassed")
                    ->equal("comment", "voucher:" . $code)
            )->read();
        }
    }

    header("Location: http://neverssl.com");
    exit;

} catch (Exception $e) {

    if ($pdo->inTransaction()) {
        $pdo->rollBack();
    }

    logVoucher($e->getMessage());

    header("Location: index.php?error=" . urlencode($e->getMessage()));
    exit;
}
