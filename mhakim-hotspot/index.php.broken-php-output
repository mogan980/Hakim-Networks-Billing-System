    return htmlspecialchars((string)$v, ENT_QUOTES, "UTF-8");
}

function speedLabel($down, $up){
    return strtoupper(trim($down ?: "6M")) . " / " . strtoupper(trim($up ?: "2M"));
}

function packageBadge($price){
    $price = (float)$price;
    if($price >= 1000) return "MONTHLY";
    if($price >= 250) return "WEEKLY";
    if($price <= 20) return "QUICK";
    return "POPULAR";
}
