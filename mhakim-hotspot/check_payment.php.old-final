<?php
header("Content-Type: application/json");
date_default_timezone_set("Africa/Nairobi");

require_once "/var/www/html/mhakim-billing-system/config/database.php";
require_once "/var/www/html/vendor/autoload.php";

use RouterOS\Client;
use RouterOS\Config;
use RouterOS\Query;

$checkoutId = $_GET["checkout_id"] ?? "";

function out($arr){
    echo json_encode($arr);
    exit;
}

function cleanSpeed($speed, $fallback){
    $speed = trim((string)$speed);
    if ($speed === "") return $fallback;
    if (preg_match('/^\d+$/', $speed)) return $speed . "M";
    return strtoupper($speed);
}

function activateUser($pdo, $checkoutId){
    $stmt = $pdo->prepare("
        SELECT payments.*, clients.username, clients.password, clients.package_id,
               packages.speed_down, packages.speed_up, packages.duration_hours
        FROM payments
        LEFT JOIN clients ON clients.phone = payments.phone OR clients.username = payments.phone
        LEFT JOIN packages ON clients.package_id = packages.id
        WHERE payments.checkout_id=?
        ORDER BY clients.id DESC
        LIMIT 1
    ");
    $stmt->execute([$checkoutId]);
    $row = $stmt->fetch(PDO::FETCH_ASSOC);

    if (!$row || !$row["username"]) return null;

    $duration = (float)($row["duration_hours"] ?? 1);
    if ($duration <= 0) $duration = 1;

    $expiresAt = date("Y-m-d H:i:s", strtotime("+{$duration} hours"));

    $pdo->prepare("
        UPDATE clients
        SET status='active', starts_at=NOW(), expires_at=?
        WHERE username=?
    ")->execute([$expiresAt, $row["username"]]);

    $settings = $pdo->query("SELECT * FROM mikrotik_settings ORDER BY id DESC LIMIT 1")->fetch(PDO::FETCH_ASSOC);
    if (!$settings) return null;

    $api = new Client(new Config([
        "host"=>$settings["router_ip"],
        "user"=>$settings["router_username"],
        "pass"=>$settings["router_password"],
        "port"=>(int)$settings["api_port"],
        "timeout"=>5
    ]));

    $down = cleanSpeed($row["speed_down"] ?? "", "6M");
    $up = cleanSpeed($row["speed_up"] ?? "", "2M");
    $profileName = "PAYMENT-" . $down . "-" . $up;
    $maxLimit = $down . "/" . $up;

    $profile = $api->query(
        (new Query("/ip/hotspot/user/profile/print"))->where("name", $profileName)
    )->read();

    if (empty($profile)) {
        $api->query(
            (new Query("/ip/hotspot/user/profile/add"))
                ->equal("name", $profileName)
                ->equal("rate-limit", $maxLimit)
                ->equal("shared-users", "1")
        )->read();
    }

    $user = $api->query(
        (new Query("/ip/hotspot/user/print"))->where("name", $row["username"])
    )->read();

    if (empty($user)) {
        $api->query(
            (new Query("/ip/hotspot/user/add"))
                ->equal("name", $row["username"])
                ->equal("password", $row["password"])
                ->equal("profile", $profileName)
                ->equal("comment", "mpesa:" . ($row["mpesa_receipt"] ?? $checkoutId))
                ->equal("disabled", "no")
        )->read();
    } else {
        $api->query(
            (new Query("/ip/hotspot/user/set"))
                ->equal(".id", $user[0][".id"])
                ->equal("password", $row["password"])
                ->equal("profile", $profileName)
                ->equal("disabled", "no")
        )->read();
    }

    return [
        "username"=>$row["username"],
        "password"=>$row["password"],
        "login_url"=>"http://login.hakim/login"
    ];
}

if (!$checkoutId) out(["status"=>"missing"]);

$pay = $pdo->prepare("SELECT * FROM payments WHERE checkout_id=? ORDER BY id DESC LIMIT 1");
$pay->execute([$checkoutId]);
$payment = $pay->fetch(PDO::FETCH_ASSOC);

if (!$payment) out(["status"=>"pending"]);

if ($payment["status"] === "paid") {
    $login = activateUser($pdo, $checkoutId);
    out(["status"=>"paid"] + ($login ?? []));
}

if ($payment["status"] === "failed") {
    out(["status"=>"failed"]);
}

/* Fallback Daraja STK query */
$mpesa = $pdo->query("SELECT * FROM mpesa_settings WHERE status='active' ORDER BY id DESC LIMIT 1")->fetch(PDO::FETCH_ASSOC);
if (!$mpesa) out(["status"=>"pending"]);

$base = strtolower($mpesa["environment"] ?? "sandbox") === "live"
    ? "https://api.safaricom.co.ke"
    : "https://sandbox.safaricom.co.ke";

$credentials = base64_encode(trim($mpesa["consumer_key"]) . ":" . trim($mpesa["consumer_secret"]));

$ch = curl_init($base . "/oauth/v1/generate?grant_type=client_credentials");
curl_setopt_array($ch, [
    CURLOPT_HTTPHEADER => ["Authorization: Basic " . $credentials],
    CURLOPT_RETURNTRANSFER => true,
    CURLOPT_TIMEOUT => 20
]);
$tokenRaw = curl_exec($ch);
curl_close($ch);

$token = json_decode($tokenRaw, true)["access_token"] ?? null;
if (!$token) out(["status"=>"pending"]);

$timestamp = date("YmdHis");
$password = base64_encode(trim($mpesa["shortcode"]) . trim($mpesa["passkey"]) . $timestamp);

$query = [
    "BusinessShortCode"=>trim($mpesa["shortcode"]),
    "Password"=>$password,
    "Timestamp"=>$timestamp,
    "CheckoutRequestID"=>$checkoutId
];

$ch = curl_init($base . "/mpesa/stkpushquery/v1/query");
curl_setopt_array($ch, [
    CURLOPT_HTTPHEADER => [
        "Content-Type: application/json",
        "Authorization: Bearer " . $token
    ],
    CURLOPT_POST => true,
    CURLOPT_POSTFIELDS => json_encode($query),
    CURLOPT_RETURNTRANSFER => true,
    CURLOPT_TIMEOUT => 20
]);
$resRaw = curl_exec($ch);
curl_close($ch);

$res = json_decode($resRaw, true);
$resultCode = (string)($res["ResultCode"] ?? "");

if ($resultCode === "0") {
    $pdo->prepare("
        UPDATE payments
        SET status='paid',
            mpesa_receipt=COALESCE(mpesa_receipt, CONCAT('STK-', id))
        WHERE checkout_id=?
    ")->execute([$checkoutId]);

    $login = activateUser($pdo, $checkoutId);
    out(["status"=>"paid"] + ($login ?? []));
}

if (in_array($resultCode, ["1032","1037","1"])) {
    $pdo->prepare("UPDATE payments SET status='failed' WHERE checkout_id=?")->execute([$checkoutId]);
    out(["status"=>"failed"]);
}

out(["status"=>"pending"]);
