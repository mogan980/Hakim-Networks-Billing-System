<?php
date_default_timezone_set("Africa/Nairobi");

require_once "/var/www/html/mhakim-billing-system/config/database.php";

$package_id = $_POST["package_id"] ?? null;
$phone = trim($_POST["phone"] ?? "");
$client_ip = $_SERVER["REMOTE_ADDR"] ?? "";

if (!$package_id || !$phone) {
    die("Package or phone missing");
}

$pkg = $pdo->prepare("SELECT * FROM packages WHERE id=? LIMIT 1");
$pkg->execute([$package_id]);
$package = $pkg->fetch(PDO::FETCH_ASSOC);

if (!$package) {
    die("Invalid package");
}

$phone254 = preg_replace('/^0/', '254', $phone);
$username = $phone;
$password = substr($phone, -4);

$mpesa = $pdo->query("SELECT * FROM mpesa_settings WHERE status='active' ORDER BY id DESC LIMIT 1")->fetch(PDO::FETCH_ASSOC);

if (!$mpesa) {
    die("M-Pesa settings missing");
}

$credentials = base64_encode(trim($mpesa["consumer_key"]) . ":" . trim($mpesa["consumer_secret"]));

$tokenUrl = "https://sandbox.safaricom.co.ke/oauth/v1/generate?grant_type=client_credentials";

$ch = curl_init($tokenUrl);
curl_setopt_array($ch, [
    CURLOPT_HTTPHEADER => [
        "Authorization: Basic " . $credentials,
        "Accept: application/json"
    ],
    CURLOPT_RETURNTRANSFER => true,
    CURLOPT_TIMEOUT => 30,
]);

$tokenRaw = curl_exec($ch);
curl_close($ch);

$tokenData = json_decode($tokenRaw, true);
$accessToken = $tokenData["access_token"] ?? null;

if (!$accessToken) {
    die("M-Pesa token failed");
}

$timestamp = date("YmdHis");
$shortcode = trim($mpesa["shortcode"]);
$passkey = trim($mpesa["passkey"]);
$darajaPassword = base64_encode($shortcode . $passkey . $timestamp);

$stkData = [
    "BusinessShortCode" => $shortcode,
    "Password" => $darajaPassword,
    "Timestamp" => $timestamp,
    "TransactionType" => "CustomerPayBillOnline",
    "Amount" => (int)$package["price"],
    "PartyA" => $phone254,
    "PartyB" => $shortcode,
    "PhoneNumber" => $phone254,
    "CallBackURL" => trim($mpesa["callback_url"]),
    "AccountReference" => "MHAKIM-" . $package["id"],
    "TransactionDesc" => "Hakim Internet " . $package["name"]
];

$ch = curl_init("https://sandbox.safaricom.co.ke/mpesa/stkpush/v1/processrequest");
curl_setopt_array($ch, [
    CURLOPT_HTTPHEADER => [
        "Content-Type: application/json",
        "Authorization: Bearer " . $accessToken
    ],
    CURLOPT_POST => true,
    CURLOPT_POSTFIELDS => json_encode($stkData),
    CURLOPT_RETURNTRANSFER => true,
    CURLOPT_TIMEOUT => 30,
]);

$stkRaw = curl_exec($ch);
curl_close($ch);

$stk = json_decode($stkRaw, true);

$checkoutId = $stk["CheckoutRequestID"] ?? null;

if (!$checkoutId) {
    die("STK push failed: " . htmlspecialchars($stkRaw));
}

$expiresAt = date("Y-m-d H:i:s", strtotime("+" . (float)$package["duration_hours"] . " hours"));

$pdo->beginTransaction();

$clientStmt = $pdo->prepare("
    INSERT INTO clients
    (full_name, phone, username, password, package_id, status, starts_at, expires_at, client_ip, connection_type)
    VALUES (?, ?, ?, ?, ?, 'pending', NOW(), ?, ?, 'hotspot')
    ON DUPLICATE KEY UPDATE
        phone=VALUES(phone),
        password=VALUES(password),
        package_id=VALUES(package_id),
        status='pending',
        starts_at=NOW(),
        expires_at=VALUES(expires_at),
        client_ip=VALUES(client_ip),
        connection_type='hotspot'
");

$clientStmt->execute([
    $username,
    $phone254,
    $username,
    $password,
    $package_id,
    $expiresAt,
    $client_ip
]);

$payStmt = $pdo->prepare("
    INSERT INTO payments(phone, amount, status, checkout_id, created_at)
    VALUES(?, ?, 'pending', ?, NOW())
    ON DUPLICATE KEY UPDATE
        phone=VALUES(phone),
        amount=VALUES(amount),
        status='pending',
        created_at=NOW()
");

$payStmt->execute([
    $phone254,
    $package["price"],
    $checkoutId
]);

$pdo->commit();

header("Location: wait_payment.php?checkout_id=" . urlencode($checkoutId));
exit;
