<?php
require_once "/var/www/html/mhakim-billing-system/config/database.php";

date_default_timezone_set("Africa/Nairobi");

try {
    $stmt = $pdo->query("
        SELECT *
        FROM packages
        WHERE status='active'
        ORDER BY price ASC
    ");
    $packages = $stmt->fetchAll(PDO::FETCH_ASSOC);
} catch (Exception $e) {
    die("Failed to load packages: " . $e->getMessage());
}

function speedText($down, $up){
    $down = trim((string)$down);
    $up = trim((string)$up);

    if($down === "") $down = "6M";
    if($up === "") $up = "2M";

    return strtoupper($down) . " / " . strtoupper($up);
}
